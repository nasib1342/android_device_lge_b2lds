# LG G3 Stylus D690/D693n (b2lds), MT6582 legacy DumChar layout
# These paths are based on on-device /proc/dumchar_info and /dev listing.

/boot           emmc    /dev/bootimg          flags=display="Boot";backup=1
/recovery       emmc    /dev/recovery         flags=display="Recovery";backup=1
/misc           emmc    /dev/misc             flags=display="Misc";backup=0
/uboot          emmc    /dev/uboot            flags=display="Uboot";backup=0
/logo           emmc    /dev/logo             flags=display="Logo";backup=0
/laf            emmc    /dev/laf              flags=display="LAF";backup=0
/nvram          emmc    /dev/nvram            flags=display="Nvram";backup=1
/pro_info       emmc    /dev/pro_info         flags=display="ProInfo";backup=1
/protect_f      ext4    /dev/block/mmcblk0p2  flags=display="Protect_F";backup=1
/protect_s      ext4    /dev/block/mmcblk0p3  flags=display="Protect_S";backup=1
/seccfg         emmc    /dev/seccfg           flags=display="SecCfg";backup=1
/persist_lg     ext4    /dev/block/mmcblk0p5  flags=display="Persist_LG";backup=1
/persist        ext4    /dev/block/mmcblk0p6  flags=display="Persist";backup=1
/cust           ext4    /dev/block/mmcblk0p8  flags=display="Cust";backup=1
/system         ext4    /dev/block/mmcblk0p9  flags=display="System";backup=1;wipeingui
/cache          ext4    /dev/block/mmcblk0p10 flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset
/data           ext4    /dev/block/mmcblk0p11 flags=display="Data";backup=1;wipeingui;wipeduringfactoryreset;length=-16384
/external_sd    vfat    /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=display="MicroSD";storage;wipeingui;removable;backup=0
/usbotg         auto    /dev/block/sda1 /dev/block/sda flags=display="USB-OTG";storage;wipeingui;removable;backup=0
